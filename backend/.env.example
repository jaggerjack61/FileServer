# ---------------------------------------------------------------------------
# FileServer environment configuration
# Copy this file to .env and adjust values as needed.
# ---------------------------------------------------------------------------

# Django secret key (CHANGE THIS in production)
# DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
# DJANGO_DEBUG=True

# Comma-separated list of allowed hosts
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Maximum file upload size in bytes (default: 100 MB = 104857600)
FILE_UPLOAD_MAX_SIZE=104857600

# Maximum office file size for document preview/parsing in bytes (default: 20 MB)
OFFICE_PREVIEW_MAX_FILE_SIZE=20971520

# Comma-separated CORS allowed origins (defaults to localhost dev servers)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# PostgreSQL (uncomment for production)
# ---------------------------------------------------------------------------
# DB_NAME=fileserver
# DB_USER=fileserver
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------------------------------------------------------------
# S3 / MinIO storage (uncomment for production)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=fileserver
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=
